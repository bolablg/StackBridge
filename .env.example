# Runtime mode. Local mode is the default contributor setup and does not need
# Clerk, Neon, or any hosted credentials.
STACKBRIDGE_MODE=local

# Hosted mode only: set STACKBRIDGE_MODE=hosted, then provide these values in
# your deployment environment or a private .env.local file.
# DATABASE_URL=postgresql://your-neon-connection-string

# Clerk — the publishable key is intentionally public; keep the secret key private.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# For Vercel, Preview uses the Clerk development instance (`pk_test_`/`sk_test_`)
# and Production uses the Clerk production instance (`pk_live_`/`sk_live_`).
# Never use production keys in a preview, local checkout, or pull request.
# Optional when using Clerk's JWKS verification path.
# CLERK_JWT_KEY=
# Comma-separated deployed origins that are allowed to issue Clerk requests.
# CLERK_AUTHORIZED_PARTIES=https://your-preview-domain.vercel.app,https://your-production-domain.example
# Optional. Normally the frontend API domain is derived from the publishable key.
# CLERK_FRONTEND_API_URL=

# Required in hosted mode: the Clerk email that owns the access queue.
# STACKBRIDGE_ADMIN_EMAIL=you@example.com

# Optional email notification delivery for new access requests.
# RESEND_API_KEY=
# ACCESS_REQUEST_FROM_EMAIL=
